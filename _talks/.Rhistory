library(grl)
library(rgl)
x <- seq(0, 1, length= 100)
y <- seq(0, 1, length= 100)
# Create a grid of x and y values
grid <- expand.grid(x = x, y = y)
View(grid)
# Compute the z values based on the function z = x^2 + y^2
grid$z <- with(grid, x*y-(x+y)/2)
# Convert the data to a matrix format
zmatrix <- matrix(grid$z, nrow = length(x))
# Plot using persp()
persp(x, y, zmatrix, theta = 30, phi = 30, expand = 0.5, col = "lightblue", xlab = "X", ylab = "Y", zlab = "Z")
# Plot using persp()
persp(x, y, zmatrix, theta = 15, phi = 30, expand = 0.5, col = "lightblue", xlab = "X", ylab = "Y", zlab = "Z")
# Plot using persp()
persp(x, y, zmatrix, theta = -15, phi = 30, expand = 0.5, col = "lightblue", xlab = "X", ylab = "Y", zlab = "Z")
optim(c(2121,1),f,method = "L-BFGS-B",  lower = c(0,0), upper = c(1,1))
optim(c(1,0),f,method = "L-BFGS-B",  lower = c(0,0), upper = c(1,1))
p=0.2
m=50
a=2*pi
p=0.2
m=50
a=2*pi
f=function(xx){
x=xx[1]
y=xx[2]
c=p^2/4+(p-p^2)/(3*m)
v1=(p^2*x*y+(p-p^2)*(x^2+y^2)/(2*m)-(p^2/2+(p-p^2)/(2*m))*(x+y)- abs(x-y)*(p-p^2)/(2*m) +c)
if(x>y){
v2=p^2*x-p^2/2+y*(p-p^2)/m
} else{
v2=p^2*x-p^2/2+(1-y)*(p-p^2)/m
}
a=2*pi
v=-a*sin( a*(y-0.5))*v1+cos(a*(y-0.5))*v2
v=abs(v1)
return(v)
}
ff=NULL
init=matrix(1,nrow=5,ncol = 2)
init[1,]=c(0,1)
init[2,]=c(0,0)
init[3,]=c(1,1)
init[4,]=c(1,0)
init[5,]=c(.5,.5)
for (i in 1:5) {
ff[i]=optim(init[i,], f,method = "L-BFGS-B",  lower = c(0,0), upper = c(1,1),control = list(fnscale = -1))$value
}
max(ff)
(p^2/4+(p-p^2)/(3*m))
optim(init[which(ff==max(ff))[1],], f,method = "L-BFGS-B",  lower = c(0,0), upper = c(1,1),control = list(fnscale = -1)  )
